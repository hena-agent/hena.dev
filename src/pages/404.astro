---
import Layout from "@/layouts/main.astro"
---

<Layout title="Page not found" description="This page does not exist." noindex>
  <header class="legal-header">
    <a class="wordmark" href="/" aria-label="Hena home">
      <span class="brand-mark" aria-hidden="true">H</span>
      <span>Hena</span>
    </a>
  </header>
  <main id="main-content" class="not-found">
    <div>
      <p class="kicker"><span>Error 404</span></p>
      <h1>Nothing is running here.</h1>
      <a class="button button--primary" href="/">Return home <span aria-hidden="true">↗</span></a>
    </div>
    <span aria-hidden="true">404</span>
  </main>
</Layout>
