---
import { ProductPreview } from "@/components/ProductPreview"
import { WaitlistForm } from "@/components/WaitlistForm"
import { site } from "@/data/site"
import Layout from "@/layouts/main.astro"

const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? "1x00000000000000000000AA"

const providers = [
  "OpenAI",
  "Anthropic",
  "Google",
  "OpenRouter",
  "Bedrock",
  "Azure",
  "GitHub Copilot",
  "Ollama",
]
---

<Layout>
  <header class="site-header">
    <a class="wordmark" href="/" aria-label="Hena home">
      <span class="brand-mark" aria-hidden="true">H</span>
      <span>Hena</span>
    </a>
    <nav aria-label="Main navigation">
      <a href="#workspace">Workspace</a>
      <a href="#context">Context</a>
      <a href="#models">Models</a>
      <a class="header-cta" href="#waitlist">Join waitlist</a>
    </nav>
  </header>

  <main id="main-content">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="launch-pill"><span></span> One workspace · Every kind of AI work</p>
        <h1 id="hero-title"><span>Chat, code,</span><span>automate.</span><em>One living workspace.</em></h1>
        <p class="hero-description">
          Think, ship code, and run browser work in one place. Pick any model, run locally or in
          the cloud, and let each project's context update as the work changes.
        </p>
        <div class="hero-actions">
          <a class="button button--primary" href="#waitlist">
            Join the waitlist <span aria-hidden="true">↗</span>
          </a>
          <a class="text-link" href="#workspace">See how it works <span aria-hidden="true">↓</span></a>
        </div>
        <p class="hero-note">Free and open source · Desktop beta {site.launch}</p>
      </div>
      <div class="hero-product" aria-label="Hena workspace showing a coding task updating project context">
        <div class="hero-product__frame">
          <div class="hero-product__bar">
            <div aria-hidden="true"><span></span><span></span><span></span></div>
            <strong><span class="brand-mark brand-mark--small" aria-hidden="true">H</span> catalog / code</strong>
            <small><i class="hero-status-light"></i> working</small>
          </div>
          <div class="hero-product__body">
            <div class="hero-product__rail" aria-hidden="true">
              <span>Projects</span>
              <div><b>C</b><small>Chat</small></div>
              <div class="is-active"><b>{`</>`}</b><small>Code</small></div>
              <div><b>↗</b><small>Claw</small></div>
            </div>
            <div class="hero-product__session">
              <div class="hero-product__session-head">
                <div><span>SESSION / 04</span><strong>Add product search</strong></div>
                <small>GPT Codex · Local</small>
              </div>
              <div class="hero-product__thread">
                <div class="hero-task">
                  <span>You</span>
                  <p>Add search without changing how filters work.</p>
                </div>
                <div class="hero-agent">
                  <div class="hero-agent__label"><span class="status-dot"></span><strong>Hena</strong><small>working across your project</small></div>
                  <div class="hero-tool-row"><span>Read</span><code>use-product-filters.ts</code><b>✓</b></div>
                  <div class="hero-tool-row"><span>Edit</span><code>product-search.tsx</code><b>+42</b></div>
                  <div class="hero-tool-row is-running"><span>Test</span><code>catalog.test.ts</code><b>42/42</b></div>
                </div>
                <div class="hero-context-update">
                  <div><span>Context update</span><strong>Catalog filters use URL state</strong></div>
                  <b>Verified + saved</b>
                </div>
              </div>
              <div class="hero-product__composer"><span>Continue this session...</span><b>↑</b></div>
            </div>
          </div>
        </div>
        <div class="hero-model-card" aria-hidden="true">
          <small>Model changed</small>
          <div><span>O</span><strong>GPT Codex</strong><b>Active</b></div>
          <p>Project context retained</p>
        </div>
        <div class="hero-context-pulse" aria-hidden="true">
          <span></span>
          <div><small>Project context</small><strong>Updated now</strong></div>
          <b>03 facts</b>
        </div>
      </div>
    </section>

    <section id="workspace" class="preview-section" aria-labelledby="preview-title">
      <div class="section-heading section-heading--preview">
        <div>
          <p class="kicker"><span>01</span> Three ways to work</p>
          <h2 id="preview-title">Every kind of AI work.<br />One workspace.</h2>
        </div>
        <p>
          Choose Chat for thinking, Code for shipping, or Claw for recurring web work. Every
          project keeps its sessions, tools, and evolving context together.
        </p>
      </div>
      <div class="preview-label"><span>Interactive product preview</span><span>Switch projects or models ↓</span></div>
      <ProductPreview client:load />
    </section>

    <section class="modes-section" aria-labelledby="modes-title">
      <div class="section-heading">
        <div>
          <p class="kicker"><span>02</span> Purpose-built project modes</p>
          <h2 id="modes-title">Different work.<br />The same workspace.</h2>
        </div>
      </div>
      <div class="mode-grid">
        <article class="mode-card mode-card--chat">
          <div class="mode-number">01 / Chat project</div>
          <div class="mode-visual" aria-hidden="true">
            <span class="chat-line chat-line--short"></span>
            <span class="chat-line"></span>
            <span class="chat-line chat-line--medium"></span>
          </div>
          <div>
            <h3>Think in conversation.</h3>
            <p>Keep research, decisions, and conversations together without code-specific tooling.</p>
          </div>
        </article>
        <article class="mode-card mode-card--code">
          <div class="mode-number">02 / Code project</div>
          <div class="mode-visual code-visual" aria-hidden="true">
            <span><i>+</i> const context = await workspace.load()</span>
            <span><i>+</i> return agent.run(task, context)</span>
          </div>
          <div>
            <h3>Work inside the codebase.</h3>
            <p>Give every session the repository, files, terminal, and review tools it needs to ship.</p>
          </div>
        </article>
        <article class="mode-card mode-card--automate">
          <div class="mode-number">03 / Claw project</div>
          <div class="mode-visual automate-visual" aria-hidden="true">
            <span class="browser-dot"></span>
            <span>open → inspect → act → report</span>
            <i></i>
          </div>
          <div>
            <h3>Hand off repetitive web work.</h3>
            <p>Keep browser tools, running tasks, and reviewable results inside an autonomous project.</p>
          </div>
        </article>
      </div>
    </section>

    <section id="context" class="context-section" aria-labelledby="context-title">
      <div class="context-copy">
        <p class="kicker"><span>03</span> Living project context</p>
        <h2 id="context-title">Context that grows<br />with the work.</h2>
        <p>
          Hena does more than carry a transcript forward. It follows changes in the codebase,
          captures useful project knowledge, and keeps verified decisions ready for the next
          session or model.
        </p>
        <dl class="context-facts">
          <div>
            <dt>01 / Observe</dt>
            <dd>Read the latest code, tools, files, and project state.</dd>
          </div>
          <div>
            <dt>02 / Update</dt>
            <dd>Save patterns and decisions confirmed through real work.</dd>
          </div>
          <div>
            <dt>03 / Reuse</dt>
            <dd>Make that context available to every new session and model.</dd>
          </div>
        </dl>
      </div>
      <div class="context-ledger" aria-label="Example of Hena updating project context">
        <div class="context-ledger__header">
          <div>
            <span class="status-dot"></span>
            <strong>Project context</strong>
          </div>
          <span>Updating as Hena works</span>
        </div>
        <ol>
          <li>
            <span>01</span>
            <div>
              <small>Observed from the codebase</small>
              <strong>Catalog filters use URL state</strong>
              <p>Confirmed in <code>use-product-filters.ts</code></p>
            </div>
            <b class="context-step-status">Read</b>
          </li>
          <li>
            <span>02</span>
            <div>
              <small>Verified through this task</small>
              <strong>Product search follows the existing pattern</strong>
              <p>Search added · 42 tests passed</p>
            </div>
            <b class="context-step-status context-step-status--saved">Saved</b>
          </li>
          <li>
            <span>03</span>
            <div>
              <small>Ready for the next handoff</small>
              <strong>Continue without another setup pass</strong>
              <p>Available to a new session or a different model</p>
            </div>
            <b class="context-step-status">Ready</b>
          </li>
        </ol>
        <div class="context-ledger__footer">
          <span>Context updated</span>
          <strong>3 verified facts</strong>
        </div>
      </div>
    </section>

    <section id="models" class="routing-section" aria-labelledby="routing-title">
      <div class="routing-copy">
        <p class="kicker"><span>04</span> Model freedom</p>
        <h2 id="routing-title">Switch models.<br />Keep the context.</h2>
        <p>
          Pick the model you want for any session, change it while you work, or let Hena route for
          quality. The project history, tools, and context stay attached.
        </p>
        <dl class="routing-facts">
          <div><dt>75+</dt><dd>model providers</dd></div>
          <div><dt>Any</dt><dd>OpenAI-compatible API</dd></div>
          <div><dt>One</dt><dd>continuous project context</dd></div>
        </dl>
      </div>
      <div class="routing-demo" aria-label="Example model routing diagram">
        <div class="routing-request">
          <span>Incoming task</span>
          <strong>Implement and test<br />the new billing flow</strong>
        </div>
        <div class="routing-node">
          <span class="routing-node__signal"></span>
          <div><small>Model control</small><strong>Choose or auto-route</strong></div>
          <span class="routing-node__badge">Your call</span>
        </div>
        <div class="routing-options">
          <div><span class="model-glyph">A</span><p><strong>Claude Sonnet</strong><small>Active · coding + tools</small></p><b>Now</b></div>
          <div><span class="model-glyph">O</span><p><strong>GPT Codex</strong><small>Switch anytime · context ready</small></p><b>Next</b></div>
          <div><span class="model-glyph">G</span><p><strong>Gemini Pro</strong><small>Switch anytime · context ready</small></p><b>Next</b></div>
        </div>
      </div>
      <div class="providers" aria-label="Supported model providers">
        <p>Connect the models you already use</p>
        <div class="provider-list">
          {providers.map((provider) => <span>{provider}</span>)}
          <span>+ 67 more</span>
        </div>
      </div>
    </section>

    <section id="open-source" class="open-source-section" aria-labelledby="open-title">
      <div class="open-source-art" aria-hidden="true">
        <div class="source-orbit source-orbit--one"></div>
        <div class="source-orbit source-orbit--two"></div>
        <div class="source-center"><span>H</span><small>MIT</small></div>
        <span class="source-label source-label--local">LOCAL OR CLOUD</span>
        <span class="source-label source-label--extensible">OPEN SOURCE</span>
        <span class="source-label source-label--yours">PROJECT CONTEXT</span>
      </div>
      <div class="open-source-copy">
        <p class="kicker"><span>05</span> Runtime choice</p>
        <h2 id="open-title">Your machine.<br />Or the cloud.</h2>
        <p>
          Choose the runtime that fits each project. Work locally when the code and tools should
          stay on your machine, or use a cloud workspace when the task needs to run remotely.
        </p>
        <div class="local-boundary">
          <span class="status-dot"></span>
          <p><strong>The context stays with the project.</strong><br />Change runtime, session, or model without rebuilding what Hena already learned.</p>
        </div>
        <span class="source-coming">Free and MIT licensed · Source opening with the beta.</span>
      </div>
    </section>

    <section id="waitlist" class="waitlist-section" aria-labelledby="waitlist-title">
      <div class="waitlist-meta">
        <span>06 / Early access</span>
        <span>{site.launch}</span>
      </div>
      <div class="waitlist-content">
        <div>
          <p class="kicker kicker--dark"><span></span> All-in-one AI workspace</p>
          <h2 id="waitlist-title">Bring all your AI work<br />into one place.</h2>
        </div>
        <div class="waitlist-action">
          <p>Join the waitlist for the first Hena desktop beta and open-source release.</p>
          <WaitlistForm
            client:load
            siteKey={turnstileSiteKey}
            consentVersion={site.consentVersion}
          />
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <a class="wordmark" href="/" aria-label="Hena home">
      <span class="brand-mark" aria-hidden="true">H</span>
      <span>Hena</span>
    </a>
    <p>Open-source AI workspace for chat, code, and automated work.</p>
    <div>
      <a href="/privacy">Privacy</a>
      <a href={`mailto:${site.email}`}>Contact</a>
      <span>© 2026 {site.company}</span>
    </div>
  </footer>
</Layout>
